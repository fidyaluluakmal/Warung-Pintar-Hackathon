# Frontend (Vite). Ambil dari Supabase → Project Settings → API.
# PUBLISHABLE key (sb_publishable_...) aman dipakai di browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Tanpa Supabase, aplikasi tetap jalan dalam mode demo lokal
# (data disimpan di localStorage, tanpa akun).
#
# Kunci AI TIDAK boleh ada di frontend. Kunci hanya lived di Supabase
# Secrets dan dibaca di dalam Edge Function:
#
#   supabase secrets set AI_API_KEY=... AI_BASE_URL=... AI_MODEL=...
